# URL del backend GraphQL. En desarrollo local, dejar la que usa
# src/api/client.js por defecto (http://localhost:4000/graphql) y no es
# necesario crear este archivo. Para apuntar a producción (Azure), copiar
# este archivo a ".env" y completar:
EXPO_PUBLIC_API_URL=https://foodplease-api.azurewebsites.net/graphql
